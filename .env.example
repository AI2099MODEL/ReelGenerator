# GEMINI_API_KEY: Required for the Chat assistant ("MyLyfe Desk") replies.
# The secrets-gradle-plugin reads this file and injects it as BuildConfig.GEMINI_API_KEY.
# AI Studio also injects it automatically from the Secrets panel at runtime.
# Replace the value below with your real key. If blank, Chat falls back to a local
# offline acknowledgement so the thread is never left without a response.
GEMINI_API_KEY=GEMINI_API_KEY_DEFAULT
POLLINATIONS_API_KEY=POLLINATIONS_API_KEY_DEFAULT
